# Copy this file to ".env" and adjust the values.
# Never commit your real .env file.

# development | production | testing
APP_ENV=development

# Use a long random string in production
SECRET_KEY=change-this-to-a-long-random-string

# Leave empty to use the default SQLite file (instance/expenses.db)
# Example: sqlite:///expenses.db
DATABASE_URL=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Local dev server only (Render sets PORT automatically)
HOST=127.0.0.1
PORT=5000